<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hudOverlayRoot"
    android:background="@android:color/transparent"
    android:focusable="false"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/hudTeclasContainer"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#00e676"
        android:layout_gravity="start|bottom"
        android:id="@+id/fpsExteriorDebugBox"
        android:background="#cc000000"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:lineSpacingExtra="2dp"
        android:fontFamily="monospace"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginStart="8dp"
        android:elevation="12dp"/>
    <ScrollView
        android:layout_gravity="end|top"
        android:id="@+id/painelMonitorMapeadorScroll"
        android:visibility="gone"
        android:scrollbars="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="40dp"
        android:fillViewport="false"
        android:fadeScrollbars="true"
        android:overScrollMode="ifContentScrolls"
        android:layout_marginEnd="4dp"
        android:elevation="14dp">
        <TextView
            android:textSize="8sp"
            android:textColor="#b0bec5"
            android:id="@+id/painelMonitorMapeador"
            android:background="#cc0d0b1a"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="300dp"
            android:text="MONITOR…"
            android:includeFontPadding="false"
            android:lineSpacingExtra="0dp"
            android:lineSpacingMultiplier="1"
            android:fontFamily="monospace"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"/>
    </ScrollView>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="top|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/painelSuperiorHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/barraControlesHud"
            android:background="@drawable/bg_hud_panel"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:elevation="8dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:id="@+id/btnAdicionarTecla"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Adicionar"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
            <View
                android:background="#44ffffff"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:id="@+id/btnBandeja"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bandeja"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
            <View
                android:background="#44ffffff"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#4caf50"
                android:id="@+id/btnHudSalvar"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salvar"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
            <View
                android:background="#44ffffff"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ff5252"
                android:id="@+id/btnHudSair"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sair"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/painelConfigHud"
            android:background="@drawable/bg_hud_panel"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:elevation="8dp">
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#81d4fa"
                android:id="@+id/btnToggleConfig"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="2dp"
                android:paddingBottom="6dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Configurações  ▲"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/painelConfigConteudo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#eeeeee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Opacidade no Jogo:"/>
                    <SeekBar
                        android:id="@+id/seekBarOpacidadeJogo"
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:maxHeight="4dp"
                        android:max="100"
                        android:progress="30"
                        android:minHeight="4dp"
                        android:layout_marginStart="8dp"/>
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#ffff00"
                        android:gravity="end"
                        android:id="@+id/txtOpacidadeJogoPercent"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="30%"/>
                </LinearLayout>
                <Switch
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:id="@+id/switchExibirHudJogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:checked="true"
                    android:text="Exibir HUD durante o jogo"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/bandejaAvancada"
            android:background="@drawable/bg_hud_panel"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:elevation="8dp">
            <ImageView
                android:id="@+id/btnAdicionarAnalogico"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_bandeja_analog"
                android:contentDescription="Adicionar analógico"/>
            <ImageView
                android:id="@+id/btnVisaoFps"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_bandeja_fps"
                android:contentDescription="Visão FPS"
                android:layout_marginStart="8dp"/>
            <ImageView
                android:id="@+id/btnToqueRepetido"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_bandeja_repeat"
                android:contentDescription="Toque repetido"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
    <include
        android:id="@+id/panelConfigAnalogico"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/layout_panel_config_analogico"/>
    <include
        android:id="@+id/panelConfigFps"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/layout_panel_config_fps"/>
    <include
        android:id="@+id/panelConfigToque"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/layout_panel_config_toque"/>
    <include
        android:id="@+id/panelConfigToqueRep"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/layout_panel_config_toque_rep"/>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/painelExteriorCurva"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        layout="@layout/layout_painel_exterior_curva"/>
    <ImageView
        android:id="@+id/cursorVirtualMao"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_cursor_mao"
        android:contentDescription="@null"
        android:importantForAccessibility="no"/>
</FrameLayout>
