<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelConfigToqueRepRoot"
    android:background="#88000000"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_gravity="center"
        android:background="@drawable/bg_painel_config"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:focusable="true"
        android:scrollbars="vertical"
        android:clickable="true"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:elevation="10dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Toque repetido"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/btnFecharPainelToqueRep"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="✕"/>
            </LinearLayout>
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#c9b8f0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Combinações de teclas"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#e8e0f8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Tecla"/>
            <EditText
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/edtToqueRepTecla"
                android:background="@drawable/bg_campo_config"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:text="?"
                android:inputType="text"/>
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#c9b8f0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Acionar ação em"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/btnToqueRepModoToque"
                    android:background="@drawable/bg_campo_config"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:text="Toque"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/btnToqueRepModoPressionar"
                    android:background="@drawable/bg_campo_config"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:text="Pressionado"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#b39ddb"
                android:id="@+id/btnToqueRepMaisOpcoes"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Mais configurações"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/blocoToqueRepAvancado"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#c9b8f0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Propriedades"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#e8e0f8"
                        android:layout_width="28dp"
                        android:layout_height="wrap_content"
                        android:text="X"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#ffffff"
                        android:gravity="center"
                        android:id="@+id/txtToqueRepPropX"
                        android:background="@drawable/bg_campo_config"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:text="0"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#e8e0f8"
                        android:layout_width="28dp"
                        android:layout_height="wrap_content"
                        android:text="Y"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#ffffff"
                        android:gravity="center"
                        android:id="@+id/txtToqueRepPropY"
                        android:background="@drawable/bg_campo_config"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:text="0"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#e8e0f8"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Contagem"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#ffffff"
                        android:gravity="center"
                        android:id="@+id/txtToqueRepContagem"
                        android:background="@drawable/bg_campo_config"
                        android:layout_width="88dp"
                        android:layout_height="40dp"
                        android:text="5"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#e8e0f8"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Repita até a chave"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:gravity="center"
                        android:id="@+id/btnToqueRepAteChave"
                        android:background="@drawable/bg_campo_config"
                        android:layout_width="88dp"
                        android:layout_height="40dp"
                        android:text="FALSE"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <TextView
                    android:textSize="10sp"
                    android:textColor="#a898d0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Alterações salvas automaticamente"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/btnExcluirToqueRepPainel"
                    android:background="@drawable/bg_btn_excluir_hud"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="72dp"
                    android:text="Excluir"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
