<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelConfigFpsRoot"
    android:background="#88000000"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_gravity="center"
        android:background="@drawable/bg_painel_config"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:elevation="10dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/txtTituloPainelFps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Configurações da visão FPS"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/btnFecharPainelFps"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="✕"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/painelFpsPrincipal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#f0e9ff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Tecla de alternância"/>
                <EditText
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/edtFpsTecla"
                    android:background="@drawable/bg_campo_config"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:text="F1"
                    android:inputType="text"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#f0e9ff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Suspender (segurar = cursor)"/>
                <EditText
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:textColorHint="#88ffffff"
                    android:gravity="center"
                    android:id="@+id/edtFpsTeclaSuspender"
                    android:background="@drawable/bg_campo_config"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:hint="—"
                    android:inputType="text"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#f0e9ff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Sensibilidade"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textStyle="bold"
                        android:textColor="#eeeeee"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="X"/>
                    <EditText
                        android:textStyle="bold"
                        android:textColor="#ffff00"
                        android:gravity="center"
                        android:id="@+id/edtFpsSensX"
                        android:background="@drawable/bg_campo_config"
                        android:focusable="false"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:text="1.00"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textStyle="bold"
                        android:textColor="#eeeeee"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="Y"/>
                    <EditText
                        android:textStyle="bold"
                        android:textColor="#ffff00"
                        android:gravity="center"
                        android:id="@+id/edtFpsSensY"
                        android:background="@drawable/bg_campo_config"
                        android:focusable="false"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:text="0.50"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/grupoFpsAntiBlock"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Anti Block"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="#d8ccf5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Evita o atirar (lado direito) roubar a câmera ao entrar no FPS. Produto = SSPro; aqui só para A/B."/>
                    <RadioGroup
                        android:orientation="vertical"
                        android:id="@+id/radioFpsAntiBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">
                        <RadioButton
                            android:textSize="12sp"
                            android:textColor="#ffffff"
                            android:id="@+id/radioAntiBlockSspro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="SSPro (oficial)"/>
                        <RadioButton
                            android:textSize="12sp"
                            android:textColor="#ffffff"
                            android:id="@+id/radioAntiBlockSsMouse"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="SS Mouse (sem Anti-Block)"/>
                        <RadioButton
                            android:textSize="12sp"
                            android:textColor="#ffffff"
                            android:id="@+id/radioAntiBlockGgMouse"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="GG Mouse"/>
                        <RadioButton
                            android:textSize="12sp"
                            android:textColor="#ffffff"
                            android:id="@+id/radioAntiBlockBluestacks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="BlueStacks"/>
                    </RadioGroup>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="#b9a7e8"
                        android:id="@+id/txtFpsAntiBlockHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/txtExtrasFpsTitulo"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Extras"/>
                <View
                    android:id="@+id/divExtrasFps"
                    android:background="#e9ddff"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/btnAbrirTweaksFps"
                    android:background="@drawable/bg_campo_config"
                    android:padding="12dp"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Tweaks"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="18sp"
                        android:textColor="#e9ddff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"/>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#ff5252"
                    android:layout_gravity="end"
                    android:id="@+id/btnExcluirFpsPainel"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="�� Excluir"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/painelFpsTweaks"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#e9ddff"
                    android:id="@+id/btnVoltarTweaksFps"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="‹  Voltar"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Ganho de baixa velocidade"/>
                <View
                    android:background="#e9ddff"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#d8ccf5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Micro-movimentos abaixo do limiar são reduzidos pelo fator. Ativação e tecla são por eixo. Padrão: lim 20 · fator 0.60."/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#b9a7e8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Eixo X (horizontal)"/>
                <Switch
                    android:textSize="12sp"
                    android:textColor="#ffffff"
                    android:id="@+id/switchFpsLowSpeedX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Sempre ativo (X)"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#f0e9ff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Limiar X (px)"/>
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#ffff00"
                        android:gravity="end"
                        android:id="@+id/txtFpsLowSpeedLimX"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="20"
                        android:layout_weight="1"/>
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seekFpsLowSpeedLimX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxHeight="4dp"
                    android:max="50"
                    android:progress="20"
                    android:minHeight="4dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#f0e9ff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fator X"/>
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#ffff00"
                        android:gravity="end"
                        android:id="@+id/txtFpsLowSpeedFatorX"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="0.60"
                        android:layout_weight="1"/>
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seekFpsLowSpeedFatorX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxHeight="4dp"
                    android:max="90"
                    android:progress="50"
                    android:minHeight="4dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#f0e9ff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Tecla X (segurar)"/>
                <EditText
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/edtFpsLowSpeedTeclaX"
                    android:background="@drawable/bg_campo_config"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:text="—"
                    android:inputType="text"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#b9a7e8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Eixo Y (vertical)"/>
                <Switch
                    android:textSize="12sp"
                    android:textColor="#ffffff"
                    android:id="@+id/switchFpsLowSpeedY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Sempre ativo (Y)"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#f0e9ff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Limiar Y (px)"/>
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#ffff00"
                        android:gravity="end"
                        android:id="@+id/txtFpsLowSpeedLimY"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="20"
                        android:layout_weight="1"/>
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seekFpsLowSpeedLimY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxHeight="4dp"
                    android:max="50"
                    android:progress="20"
                    android:minHeight="4dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#f0e9ff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fator Y"/>
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#ffff00"
                        android:gravity="end"
                        android:id="@+id/txtFpsLowSpeedFatorY"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="0.60"
                        android:layout_weight="1"/>
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seekFpsLowSpeedFatorY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxHeight="4dp"
                    android:max="90"
                    android:progress="50"
                    android:minHeight="4dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#f0e9ff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Tecla Y (segurar)"/>
                <EditText
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/edtFpsLowSpeedTeclaY"
                    android:background="@drawable/bg_campo_config"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:text="—"
                    android:inputType="text"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#d8ccf5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:text="Limiar 0 = off no eixo. Toque na tecla para definir · segure para limpar. Sempre ativo OU tecla (OR) por eixo."/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Aceleração a partir do limiar"/>
                <View
                    android:background="#e9ddff"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#d8ccf5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Movimentos acima do limiar ganham velocidade. X e Y separados. Segure a tecla para ativar (ou deixe sempre ativo)."/>
                <Switch
                    android:textSize="12sp"
                    android:textColor="#ffffff"
                    android:id="@+id/switchFpsAcelLimiar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Sempre ativo"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#b9a7e8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Eixo X (horizontal)"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#f0e9ff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Limiar X (px)"/>
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#ffff00"
                        android:gravity="end"
                        android:id="@+id/txtFpsAcelLimiarLimX"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="8"
                        android:layout_weight="1"/>
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seekFpsAcelLimiarLimX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxHeight="4dp"
                    android:max="50"
                    android:progress="8"
                    android:minHeight="4dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#f0e9ff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ganho X"/>
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#ffff00"
                        android:gravity="end"
                        android:id="@+id/txtFpsAcelLimiarGainX"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="1.50"
                        android:layout_weight="1"/>
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seekFpsAcelLimiarGainX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxHeight="4dp"
                    android:max="190"
                    android:progress="40"
                    android:minHeight="4dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#b9a7e8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Eixo Y (vertical)"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#f0e9ff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Limiar Y (px)"/>
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#ffff00"
                        android:gravity="end"
                        android:id="@+id/txtFpsAcelLimiarLimY"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="8"
                        android:layout_weight="1"/>
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seekFpsAcelLimiarLimY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxHeight="4dp"
                    android:max="50"
                    android:progress="8"
                    android:minHeight="4dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#f0e9ff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ganho Y"/>
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#ffff00"
                        android:gravity="end"
                        android:id="@+id/txtFpsAcelLimiarGainY"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="1.50"
                        android:layout_weight="1"/>
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seekFpsAcelLimiarGainY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxHeight="4dp"
                    android:max="190"
                    android:progress="40"
                    android:minHeight="4dp"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#d8ccf5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
