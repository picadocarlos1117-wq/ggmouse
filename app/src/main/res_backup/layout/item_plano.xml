<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="148dp"
    android:layout_height="wrap_content"
    android:minHeight="168dp"
    android:layout_marginHorizontal="4dp">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/cardPlanoRoot"
        android:background="@drawable/bg_shop_plan_card"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="12dp">
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/shop_text_primary"
            android:id="@+id/txtPlanoBadge"
            android:background="@drawable/bg_shop_badge_gold"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Popular"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/shop_text_primary"
            android:id="@+id/txtPlanoTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/shop_text_muted"
            android:gravity="center"
            android:id="@+id/txtPlanoSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:minHeight="12dp"
            android:layout_weight="1"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/shop_text_primary"
            android:id="@+id/btnComprarPlano"
            android:background="@drawable/bg_shop_btn_primary"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Comprar"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            app:backgroundTint="@null"
            app:cornerRadius="12dp"
            style="@style/Widget.MaterialComponents.Button"/>
    </LinearLayout>
</FrameLayout>
