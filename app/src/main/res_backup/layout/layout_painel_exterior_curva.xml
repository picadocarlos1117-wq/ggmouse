<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/painelExteriorCurva"
    android:background="@drawable/bg_hud_panel"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:elevation="14dp">
    <TextView
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#81d4fa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Compensação horizontal — verde = % do ΔX aplicado × sens 1.2"/>
    <TextView
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#ff69b4"
        android:id="@+id/txtExteriorLive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="dedo: — | origem: — | passa —%"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/linhaCurvaOpcoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/btnCurvaGraficoPartida"
            android:background="@drawable/bg_btn_azul"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Partida: gráfico ON"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>
        <TextView
            android:textSize="9sp"
            android:textColor="#aaaaaa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="rosa=dedo · amarelo=origem F1 · cinza=tela"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <HorizontalScrollView
        android:id="@+id/barraEditorCurva"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="10sp"
                android:textColor="#eeeeee"
                android:id="@+id/btnCurvaZoomAnc"
                android:background="@drawable/bg_menu_btn_icone"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Origem"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#eeeeee"
                android:id="@+id/btnCurvaZoomTela"
                android:background="@drawable/bg_menu_btn_icone"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tela"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="4dp"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#eeeeee"
                android:id="@+id/btnCurvaZoomTudo"
                android:background="@drawable/bg_menu_btn_icone"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tudo"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="4dp"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#eeeeee"
                android:id="@+id/btnCurvaZoomIn"
                android:background="@drawable/bg_menu_btn_icone"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Z+"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="8dp"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#eeeeee"
                android:id="@+id/btnCurvaZoomOut"
                android:background="@drawable/bg_menu_btn_icone"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Z−"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </HorizontalScrollView>
    <com.example.ssmousepro.hud.FpsFfGraficoView
        android:id="@+id/fpsExteriorCurva"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="4dp"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#eeeeee"
        android:id="@+id/txtExteriorCurvaSel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Quanto mais longe da origem, menor o ΔX aplicado"/>
</LinearLayout>
