<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#f4f5fb"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <ImageButton
            android:id="@+id/btnVoltarWifi"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:layout_centerVertical="true"
            android:contentDescription="Voltar"
            android:layout_alignParentStart="true"
            app:tint="#5c6bc0"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Depuração Wi‑Fi"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#5c6bc0"
        android:id="@+id/txtWifiStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Status: —"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_painel_config"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textColor="#e8e0f8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ative a Depuração sem fio no aparelho. O SS Pro usa isso como alternativa ao Shizuku."/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="1. Opções do desenvolvedor"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="#69f0ae"
                    android:id="@+id/chkWifiDev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="○"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#c9b8f0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Em Configurações do sistema → Sobre o telefone, toque 7 vezes em Número da compilação."/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="2. Depuração USB"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="#69f0ae"
                    android:id="@+id/chkWifiUsb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="○"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#c9b8f0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Nas Opções do desenvolvedor, ative Depuração USB."/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="3. Depuração sem fio"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="#69f0ae"
                    android:id="@+id/chkWifiWireless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="○"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#c9b8f0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Ative Depuração sem fio. Se o app não detectar, desligue e ligue de novo."/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="4. Emparelhar com código"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#c9b8f0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Permita notificações, toque em Emparelhar e abra “Parear com código”. Digite o código na notificação do SS Pro."/>
            <Button
                android:textColor="#ffffff"
                android:id="@+id/btnWifiEmparelhar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Emparelhar"
                android:textAllCaps="false"
                android:backgroundTint="#7e57c2"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="5. Ativar o mapeador"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#c9b8f0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="O código só emparelha. Em seguida o app ativa sozinho — espere a notificação “Wi‑Fi ativo ✅”. Se não vier, toque em Ativar com a Depuração sem fio ligada."/>
            <Button
                android:textColor="#ffffff"
                android:id="@+id/btnWifiAtivar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Ativar"
                android:textAllCaps="false"
                android:backgroundTint="#5c6bc0"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#a898d0"
                android:id="@+id/txtWifiLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text=""/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
