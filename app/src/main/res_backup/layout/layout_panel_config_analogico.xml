<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelConfigAnalogicoRoot"
    android:background="#88000000"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_gravity="center"
        android:background="@drawable/bg_painel_config"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:elevation="10dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Configurações do Analógico"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/btnFecharPainelAnalog"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="✕"/>
            </LinearLayout>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Teclado e mouse"/>
            <View
                android:background="#e9ddff"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#f0e9ff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Combinações de teclas"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#eeeeee"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Acima"/>
                <EditText
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/edtAnalogTeclaW"
                    android:background="@drawable/bg_campo_config"
                    android:focusable="false"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:text="W"
                    android:layout_weight="1"
                    android:inputType="text"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#eeeeee"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Baixo"/>
                <EditText
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/edtAnalogTeclaS"
                    android:background="@drawable/bg_campo_config"
                    android:focusable="false"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:text="S"
                    android:layout_weight="1"
                    android:inputType="text"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#eeeeee"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Esquerda"/>
                <EditText
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/edtAnalogTeclaA"
                    android:background="@drawable/bg_campo_config"
                    android:focusable="false"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:text="A"
                    android:layout_weight="1"
                    android:inputType="text"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#eeeeee"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Direita"/>
                <EditText
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/edtAnalogTeclaD"
                    android:background="@drawable/bg_campo_config"
                    android:focusable="false"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:text="D"
                    android:layout_weight="1"
                    android:inputType="text"/>
            </LinearLayout>
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#c9b8f0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Propriedades"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#e8e0f8"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="X"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/txtAnalogPropX"
                    android:background="@drawable/bg_campo_config"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="0"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#e8e0f8"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="Y"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/txtAnalogPropY"
                    android:background="@drawable/bg_campo_config"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="0"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#e8e0f8"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="Raio"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/txtAnalogPropRaio"
                    android:background="@drawable/bg_campo_config"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="0"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#e8e0f8"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="Rapidez"/>
                <EditText
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/edtAnalogRapidez"
                    android:background="@drawable/bg_campo_config"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="200"
                    android:layout_weight="1"
                    android:inputType="number"/>
            </LinearLayout>
            <TextView
                android:textSize="10sp"
                android:textColor="#a898d0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Raio = tamanho do stick. Rapidez = alcance do toque no jogo (50–400)."/>
            <Switch
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:id="@+id/switchAnalogMostrarTeclas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:checked="true"
                android:text="Mostrar teclas na tela"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <TextView
                    android:textSize="10sp"
                    android:textColor="#a898d0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Alterações salvas automaticamente"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/btnExcluirAnalogPainel"
                    android:background="@drawable/bg_btn_excluir_hud"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="72dp"
                    android:text="Excluir"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
