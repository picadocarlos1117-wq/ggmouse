<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingTop="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:background="@drawable/bg_menu_overlay"
        android:layout_width="wrap_content"
        android:layout_height="54dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:elevation="8dp">
        <ImageView
            android:id="@+id/btnMenuHud"
            android:background="@drawable/bg_menu_btn_icone"
            android:padding="8dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_keyboard"
            android:tint="#ffffff"
            android:contentDescription="Editar HUD"/>
        <View
            android:background="#55ffffff"
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btnMenuDigitar"
            android:background="@drawable/bg_digitar_off"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Digitar"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <View
            android:background="#55ffffff"
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <ImageView
            android:id="@+id/btnMenuConfig"
            android:background="@drawable/bg_menu_btn_icone"
            android:padding="8dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_settings"
            android:tint="#ffffff"
            android:contentDescription="Configurações"/>
        <View
            android:background="#55ffffff"
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#ffe0e0"
            android:gravity="center"
            android:id="@+id/btnMenuFechar"
            android:background="@drawable/bg_menu_btn_icone"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="✕"/>
    </LinearLayout>
</LinearLayout>
