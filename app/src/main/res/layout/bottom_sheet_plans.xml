<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_shop_sheet"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_shop_handle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp">
            <TextView
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/shop_text_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recarregar tempo"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/shop_text_muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Escolha um plano ou assista e sorteie tempo grátis."/>
            <ProgressBar
                android:layout_gravity="center_horizontal"
                android:id="@+id/progressPlanos"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/shop_accent"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/shop_error"
                android:id="@+id/txtPlanosErro"
                android:background="@drawable/bg_shop_pill"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/shop_text_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:text="PLANOS"
                android:letterSpacing="0.04"/>
        </LinearLayout>
        <HorizontalScrollView
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:paddingHorizontal="16dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/listaPlanos"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </HorizontalScrollView>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_shop_reward_card"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginHorizontal="16dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:background="@drawable/bg_shop_chip"
                    android:padding="8dp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_shop_play"
                    android:contentDescription="@null"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/shop_text_primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tempo grátis"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/shop_text_secondary"
                        android:id="@+id/txtVideoRewardInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Assista para ganhar de 1h a 24h (Prêmio Aleatório)"/>
                </LinearLayout>
            </LinearLayout>
            <HorizontalScrollView
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:overScrollMode="never">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/shop_text_primary"
                        android:background="@drawable/bg_shop_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1h · 70%"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/shop_text_primary"
                        android:background="@drawable/bg_shop_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2h · 18%"
                        android:layout_marginStart="6dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/shop_text_primary"
                        android:background="@drawable/bg_shop_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6h · 8%"
                        android:layout_marginStart="6dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/shop_text_primary"
                        android:background="@drawable/bg_shop_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12h · 3%"
                        android:layout_marginStart="6dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"/>
                    <TextView
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/shop_text_primary"
                        android:background="@drawable/bg_shop_badge_gold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24h · 1%"
                        android:layout_marginStart="6dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"/>
                </LinearLayout>
            </HorizontalScrollView>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/shop_text_secondary"
                    android:gravity="center"
                    android:id="@+id/txtVideosRestantesHoje"
                    android:background="@drawable/bg_shop_pill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Hoje: 6/6"
                    android:layout_weight="1"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="7dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/shop_text_secondary"
                    android:gravity="center"
                    android:id="@+id/txtPityProgresso"
                    android:background="@drawable/bg_shop_pill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Bônus: 0/24"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="7dp"/>
            </LinearLayout>
            <ProgressBar
                android:id="@+id/progressPityBar"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:max="24"
                android:progress="0"
                android:progressDrawable="@drawable/bg_shop_pity_progress"
                style="?android:attr/progressBarStyleHorizontal"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/shop_text_muted"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Complete 24 vídeos e ganhe +1 dia de bônus"
                android:drawablePadding="6dp"
                app:drawableStartCompat="@drawable/ic_shop_star"/>
            <com.google.android.material.button.MaterialButton
                android:textSize="13sp"
                android:textColor="@color/shop_text_primary"
                android:id="@+id/btnAssistirVideo"
                android:background="@drawable/bg_shop_btn_primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="Assista para ganhar de 1h a 24h (Prêmio Aleatório)"
                android:maxLines="2"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:paddingHorizontal="12dp"
                app:backgroundTint="@null"
                app:cornerRadius="14dp"
                style="@style/Widget.MaterialComponents.Button"/>
            <ProgressBar
                android:layout_gravity="center_horizontal"
                android:id="@+id/progressVideo"
                android:visibility="gone"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="8dp"
                android:indeterminateTint="@color/shop_accent"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/shop_text_secondary"
            android:id="@+id/btnFecharPlanos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Fechar"
            android:textAllCaps="false"
            android:layout_marginHorizontal="16dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
