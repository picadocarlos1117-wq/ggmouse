<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#ffffff"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">
        <ImageButton
            android:id="@+id/btnVoltar"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:layout_centerVertical="true"
            android:contentDescription="Voltar"
            android:layout_alignParentStart="true"
            app:tint="#5c6bc0"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:id="@+id/txtTituloPrefs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configurações"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ScrollView
            android:id="@+id/painelMenuPrefs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMenuPermissoes"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#e8eaf6"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">
                    <RelativeLayout
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#3f51b5"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Permissões"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/setaPermissoes"/>
                        <TextView
                            android:textSize="22sp"
                            android:textColor="#5c6bc0"
                            android:id="@+id/setaPermissoes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMenuAtalhos"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#e8eaf6"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">
                    <RelativeLayout
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#3f51b5"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Atalhos"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/setaAtalhos"/>
                        <TextView
                            android:textSize="22sp"
                            android:textColor="#5c6bc0"
                            android:id="@+id/setaAtalhos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMenuModoAtivacao"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#e8eaf6"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">
                    <RelativeLayout
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="8dp"
                            android:layout_toStartOf="@+id/setaModoAtivacao">
                            <TextView
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#3f51b5"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Modo de ativação"/>
                            <TextView
                                android:textSize="13sp"
                                android:textColor="#5c6bc0"
                                android:id="@+id/txtModoAtivacaoResumo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Shizuku (recomendado)"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="22sp"
                            android:textColor="#5c6bc0"
                            android:id="@+id/setaModoAtivacao"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:text="Conta"/>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#f5f5f5"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#444444"
                            android:id="@+id/txtContaEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="—"/>
                        <Button
                            android:textSize="12sp"
                            android:textColor="#ffffff"
                            android:id="@+id/btnSairConta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Sair da conta"
                            android:backgroundTint="#e53935"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>
        <ScrollView
            android:id="@+id/painelPermissoesPrefs"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#e8eaf6"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">
                    <RelativeLayout
                        android:padding="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="8dp"
                            android:layout_toStartOf="@+id/btnPermissaoSobreposicao">
                            <TextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#3f51b5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sobreposição de tela"/>
                            <TextView
                                android:textSize="13sp"
                                android:textColor="#5c6bc0"
                                android:id="@+id/txtStatusSobreposicao"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Verificando…"/>
                        </LinearLayout>
                        <Button
                            android:textSize="12sp"
                            android:textColor="#ffffff"
                            android:id="@+id/btnPermissaoSobreposicao"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Configurar"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true"
                            android:backgroundTint="#5c6bc0"/>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#e8eaf6"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">
                    <RelativeLayout
                        android:padding="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="8dp"
                            android:layout_toStartOf="@+id/btnPermissaoUso">
                            <TextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#3f51b5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Detectar jogo aberto"/>
                            <TextView
                                android:textSize="13sp"
                                android:textColor="#5c6bc0"
                                android:id="@+id/txtStatusUso"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Necessário para ocultar a bolinha fora do jogo"/>
                        </LinearLayout>
                        <Button
                            android:textSize="12sp"
                            android:textColor="#ffffff"
                            android:id="@+id/btnPermissaoUso"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Configurar"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true"
                            android:backgroundTint="#5c6bc0"/>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardStatusShizuku"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#e8eaf6"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">
                    <RelativeLayout
                        android:padding="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#3f51b5"
                            android:id="@+id/txtStatusShizuku"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Verificando Shizuku…"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="8dp"
                            android:layout_toStartOf="@+id/btnAtivarShizuku"/>
                        <Button
                            android:textSize="12sp"
                            android:textColor="#ffffff"
                            android:id="@+id/btnAtivarShizuku"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ativar"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true"
                            android:backgroundTint="#5c6bc0"/>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>
        <ScrollView
            android:id="@+id/painelAtalhosPrefs"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="#e8eaf6"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#3f51b5"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Editar HUD"
                                android:layout_weight="1"/>
                            <TextView
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#ffffff"
                                android:gravity="center"
                                android:id="@+id/chipAtalhoEditarHud"
                                android:background="@drawable/bg_campo_config"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:minWidth="72dp"
                                android:text="—"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"/>
                        </LinearLayout>
                        <View
                            android:background="#22000000"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#3f51b5"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Digitar"
                                android:layout_weight="1"/>
                            <TextView
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#ffffff"
                                android:gravity="center"
                                android:id="@+id/chipAtalhoDigitar"
                                android:background="@drawable/bg_campo_config"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:minWidth="72dp"
                                android:text="—"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"/>
                        </LinearLayout>
                        <View
                            android:background="#22000000"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#3f51b5"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Configurações"
                                android:layout_weight="1"/>
                            <TextView
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#ffffff"
                                android:gravity="center"
                                android:id="@+id/chipAtalhoConfig"
                                android:background="@drawable/bg_campo_config"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:minWidth="72dp"
                                android:text="—"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Toque na tecla para definir · segura para limpar. Funcionam com o mapeador aberto no jogo."/>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
